APP_NAME=劳动权益咨询问答台
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
LOG_LEVEL=INFO

# Auth
AUTH_COOKIE_SECURE=false
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_RATE_LIMIT_SECRET=
AUTH_TRUST_PROXY_CLIENT_IP=false
# 以下测试管理员仅用于本地开发；生产部署使用 deploy/.env.example，不能启用。
AUTH_DEV_SEED_ADMIN_ENABLED=true
AUTH_DEV_SEED_ADMIN_IDENTIFIER=admin1
AUTH_DEV_SEED_ADMIN_PASSWORD=123456

DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./uploads
FAISS_DIR=./data/faiss
MAX_UPLOAD_SIZE_MB=20
DOC_PARSER_BACKEND=package
DOC_CONVERTER=libreoffice
CHUNK_SIZE=600
CHUNK_OVERLAP=100

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Rewrite
LLM_REWRITE_TEMPERATURE=0.1
LLM_REWRITE_TOP_P=1.0
LLM_REWRITE_MAX_TOKENS=512

# Evidence Judge
LLM_EVIDENCE_TEMPERATURE=0.0
LLM_EVIDENCE_TOP_P=1.0
LLM_EVIDENCE_MAX_TOKENS=1024

# Answer
LLM_ANSWER_TEMPERATURE=0.2
LLM_ANSWER_TOP_P=1.0
LLM_ANSWER_MAX_TOKENS=4096

RAG_CANDIDATE_K=20
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
LIGHTWEIGHT_RERANK_ENABLED=true
RAG_NEIGHBOR_EXPAND_TOP_N=3
RAG_NEIGHBOR_RADIUS=1
RAG_EVIDENCE_LIMIT=10
RERANK_ENABLED=false
RERANK_TOP_N=5
DEFAULT_ANSWER_STYLE=plain

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_MODEL=
