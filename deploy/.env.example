APP_NAME=劳动权益咨询问答台
APP_ENV=production
API_PREFIX=/api
LOG_LEVEL=INFO
CORS_ORIGINS=["https://mauriceliang.xyz"]

# Auth: use HTTPS cookies and a stable random secret generated for this deployment.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_RATE_LIMIT_SECRET=
AUTH_TRUST_PROXY_CLIENT_IP=true
AUTH_DEV_SEED_ADMIN_ENABLED=false
# 首次启动且数据库中没有系统管理员时用于自动创建首位管理员；创建并确认可登录后删除这两项。
AUTH_BOOTSTRAP_ADMIN_IDENTIFIER=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./uploads
FAISS_DIR=./data/faiss

MAX_UPLOAD_SIZE_MB=20

DOC_PARSER_BACKEND=libreoffice
DOC_CONVERTER=libreoffice

CHUNK_SIZE=600
CHUNK_OVERLAP=100

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Rewrite
LLM_REWRITE_TEMPERATURE=0.1
LLM_REWRITE_TOP_P=1.0
LLM_REWRITE_MAX_TOKENS=512

# Evidence Judge
LLM_EVIDENCE_TEMPERATURE=0.0
LLM_EVIDENCE_TOP_P=1.0
LLM_EVIDENCE_MAX_TOKENS=1024

# Answer
LLM_ANSWER_TEMPERATURE=0.2
LLM_ANSWER_TOP_P=1.0
LLM_ANSWER_MAX_TOKENS=4096

RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35

RERANK_ENABLED=false
RERANK_TOP_N=5

DEFAULT_ANSWER_STYLE=plain

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=32

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_MODEL=
